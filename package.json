{
  "name": "dubazaarmart-system",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "pnpm --filter @dubazaarmart/frontend dev",
    "dev:backend": "pnpm --filter @dubazaarmart/backend start:dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint frontend backend",
    "format": "oxfmt",
    "db:migrate": "pnpm --filter @dubazaarmart/backend db:migrate",
    "db:migration:show": "pnpm --filter @dubazaarmart/backend db:migration:show",
    "db:seed": "pnpm --filter @dubazaarmart/backend db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "oxfmt": "^0.2.0",
    "typescript-eslint": "^8.73.0"
  }
}
